# commands
%cc-executable-cmd{
	if { $CC $LDFLAGS -o $3 $:{@} $LDLIBS }
}
%cc-library-cmd{
	if { $AR rc $3 $:{@} }
	if { $RANLIB $3 }
}
%cc-obj-cmd{
	if { $CC $CFLAGS $CPPFLAGS -o $3 -c ${2}.c }
}
# default
default.c{
}
default.s{
}
default.c.o{
	module:std-cmd
	cmd{
		command:$:{%cc-obj-cmd}
		${2}.c
	}
}
default.s.o{
	module:std-cmd
	cmd{
		command:$:{%cc-obj-cmd}
		${2}.s
	}
}
default.a{
	command:$:{%cc-library-cmd}
}
$@program{
	module:std-library
	library{
		command:$:{%cc-executable-cmd}
	}
	${2}.c.o
}
$@library{
	${default.a}
}
